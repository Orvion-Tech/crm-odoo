<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================
         Report action — registers the printable doc
         ============================================ -->
    <record id="action_report_quotation" model="ir.actions.report">
        <field name="name">Quotation</field>
        <field name="model">crm.quotation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">crm_custom.report_quotation_document</field>
        <field name="report_file">crm_custom.report_quotation_document</field>
        <field name="binding_model_id" ref="model_crm_quotation"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ============================================
         Document body
         ============================================ -->
    <template id="report_quotation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <!-- Title -->
                        <div class="row mt-4 mb-3">
                            <div class="col-7">
                                <h2 style="color:#3b3a73;margin-bottom:0;">
                                    Quotation
                                </h2>
                                <div style="color:#f59e0b;font-weight:600;letter-spacing:1px;">
                                    <span t-field="o.reference"/>
                                </div>
                            </div>
                            <div class="col-5 text-end">
                                <table class="table table-sm" style="font-size:13px;">
                                    <tr>
                                        <td><strong>Date</strong></td>
                                        <td><span t-field="o.date"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Valid Until</strong></td>
                                        <td style="color:#f59e0b;font-weight:600;">
                                            <span t-field="o.validity_date"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Salesperson</strong></td>
                                        <td><span t-field="o.user_id.name"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Customer block -->
                        <div class="row mb-4" style="background:#f8f9ff;padding:14px;border-radius:8px;">
                            <div class="col-12">
                                <strong style="color:#3b3a73;text-transform:uppercase;font-size:11px;letter-spacing:1px;">
                                    Bill To
                                </strong>
                                <div style="font-size:14px;margin-top:4px;">
                                    <strong t-out="o.contact_name or (o.partner_id and o.partner_id.name) or ''"/>
                                </div>
                                <div t-if="o.partner_id" style="font-size:13px;color:#555;">
                                    <span t-field="o.partner_id"
                                          t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": true}'/>
                                </div>
                                <div t-if="not o.partner_id" style="font-size:13px;color:#555;">
                                    <span t-if="o.phone"><i class="fa fa-phone"/> <span t-field="o.phone"/></span>
                                    <span t-if="o.email"> &amp;nbsp; <i class="fa fa-envelope"/> <span t-field="o.email"/></span>
                                </div>
                            </div>
                        </div>

                        <!-- Lines -->
                        <table class="table table-sm" style="font-size:13px;">
                            <thead style="background:#3b3a73;color:white;">
                                <tr>
                                    <th>Product</th>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Discount %</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.product_id.name"/></td>
                                    <td><span t-field="line.description"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end">
                                        <span t-field="line.unit_price"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="line.discount or 0" t-options='{"widget": "float", "precision": 2}'/>%
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Total -->
                        <div class="row mt-3">
                            <div class="col-7"/>
                            <div class="col-5">
                                <table class="table table-sm" style="border-top:2px solid #f59e0b;">
                                    <tr>
                                        <td style="font-size:14px;color:#3b3a73;">
                                            <strong>TOTAL</strong>
                                        </td>
                                        <td class="text-end" style="font-size:18px;font-weight:700;color:#3b3a73;">
                                            <span t-field="o.amount_untaxed"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Terms & Conditions -->
                        <div t-if="o.terms_conditions" class="mt-4"
                             style="padding:14px;background:#f8f9ff;border-left:3px solid #f59e0b;border-radius:4px;">
                            <strong style="color:#3b3a73;text-transform:uppercase;font-size:11px;letter-spacing:1px;">
                                Terms &amp; Conditions
                            </strong>
                            <div style="font-size:13px;color:#444;margin-top:6px;">
                                <span t-field="o.terms_conditions"/>
                            </div>
                        </div>

                        <!-- Footer note -->
                        <div class="mt-5" style="font-size:12px;color:#666;text-align:center;">
                            <p>Thank you for your business.</p>
                            <p>For any questions, please contact <span t-field="o.user_id.name"/>
                                <span t-if="o.user_id.email">at <span t-field="o.user_id.email"/></span>.
                            </p>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
