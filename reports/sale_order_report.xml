<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report action -->
    <record id="action_report_sale_order" model="ir.actions.report">
        <field name="name">Sales Order</field>
        <field name="model">crm.sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">crm_custom.report_sale_order_document</field>
        <field name="report_file">crm_custom.report_sale_order_document</field>
        <field name="binding_model_id" ref="model_crm_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Document body -->
    <template id="report_sale_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <!-- Title -->
                        <div class="row mt-4 mb-3">
                            <div class="col-7">
                                <h2 style="color:#3b3a73;margin-bottom:0;">
                                    Sales Order
                                </h2>
                                <div style="color:#16a34a;font-weight:600;letter-spacing:1px;">
                                    <span t-field="o.reference"/>
                                </div>
                            </div>
                            <div class="col-5 text-end">
                                <table class="table table-sm" style="font-size:13px;">
                                    <tr>
                                        <td><strong>Order Date</strong></td>
                                        <td><span t-field="o.date"/></td>
                                    </tr>
                                    <tr t-if="o.confirmation_date">
                                        <td><strong>Confirmed On</strong></td>
                                        <td><span t-field="o.confirmation_date"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Expected Delivery</strong></td>
                                        <td style="color:#3b3a73;font-weight:600;">
                                            <span t-if="o.expected_delivery_date" t-field="o.expected_delivery_date"/>
                                            <span t-else="">To be confirmed</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Salesperson</strong></td>
                                        <td><span t-field="o.user_id.name"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Customer block -->
                        <div class="row mb-4">
                            <div class="col-6" style="background:#f8f9ff;padding:14px;border-radius:8px;">
                                <strong style="color:#3b3a73;text-transform:uppercase;font-size:11px;letter-spacing:1px;">
                                    Bill To
                                </strong>
                                <div style="font-size:14px;margin-top:4px;">
                                    <strong t-out="o.contact_name or (o.partner_id and o.partner_id.name) or ''"/>
                                </div>
                                <div t-if="o.partner_id" style="font-size:13px;color:#555;">
                                    <span t-field="o.partner_id"
                                          t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": true}'/>
                                </div>
                                <div t-if="not o.partner_id" style="font-size:13px;color:#555;">
                                    <span t-if="o.phone"><i class="fa fa-phone"/> <span t-field="o.phone"/></span>
                                    <span t-if="o.email"> &amp;nbsp; <i class="fa fa-envelope"/> <span t-field="o.email"/></span>
                                </div>
                            </div>
                            <div t-if="o.delivery_address" class="col-6" style="background:#f8f9ff;padding:14px;border-radius:8px;margin-left:8px;">
                                <strong style="color:#3b3a73;text-transform:uppercase;font-size:11px;letter-spacing:1px;">
                                    Ship To
                                </strong>
                                <div style="font-size:13px;color:#555;margin-top:4px;white-space:pre-wrap;">
                                    <span t-field="o.delivery_address"/>
                                </div>
                            </div>
                        </div>

                        <!-- Lines -->
                        <table class="table table-sm" style="font-size:13px;">
                            <thead style="background:#3b3a73;color:white;">
                                <tr>
                                    <th>Product</th>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Discount %</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.product_id.name"/></td>
                                    <td><span t-field="line.description"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end">
                                        <span t-field="line.unit_price"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="line.discount or 0" t-options='{"widget": "float", "precision": 2}'/>%
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Total -->
                        <div class="row mt-3">
                            <div class="col-7"/>
                            <div class="col-5">
                                <table class="table table-sm" style="border-top:2px solid #f59e0b;">
                                    <tr>
                                        <td style="font-size:14px;color:#3b3a73;">
                                            <strong>TOTAL</strong>
                                        </td>
                                        <td class="text-end" style="font-size:18px;font-weight:700;color:#3b3a73;">
                                            <span t-field="o.amount_total"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Payment terms -->
                        <div class="mt-4" style="padding:14px;background:#f8f9ff;border-left:3px solid #16a34a;border-radius:4px;">
                            <strong style="color:#3b3a73;text-transform:uppercase;font-size:11px;letter-spacing:1px;">
                                Payment Terms
                            </strong>
                            <div style="font-size:13px;color:#444;margin-top:6px;">
                                <span t-if="o.payment_terms == 'custom'" t-out="o.payment_terms_custom or ''"/>
                                <span t-else="" t-out="dict(o._fields['payment_terms'].selection).get(o.payment_terms, '')"/>
                            </div>
                        </div>

                        <!-- T&C -->
                        <div t-if="o.terms_conditions" class="mt-3"
                             style="padding:14px;background:#f8f9ff;border-left:3px solid #f59e0b;border-radius:4px;">
                            <strong style="color:#3b3a73;text-transform:uppercase;font-size:11px;letter-spacing:1px;">
                                Terms &amp; Conditions
                            </strong>
                            <div style="font-size:13px;color:#444;margin-top:6px;">
                                <span t-field="o.terms_conditions"/>
                            </div>
                        </div>

                        <div class="mt-5" style="font-size:12px;color:#666;text-align:center;">
                            <p>Thank you for your order.</p>
                            <p>For any questions, please contact <span t-field="o.user_id.name"/>
                                <span t-if="o.user_id.email">at <span t-field="o.user_id.email"/></span>.
                            </p>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
