<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_crm_invoice" model="ir.sequence">
            <field name="name">CRM Invoice Sequence</field>
            <field name="code">crm.invoice</field>
            <field name="prefix">INV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="ir_cron_flag_overdue_invoices" model="ir.cron">
            <field name="name">CRM Custom: Flag Overdue Invoices</field>
            <field name="model_id" ref="model_crm_invoice"/>
            <field name="state">code</field>
            <field name="code">model._cron_flag_overdue_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
