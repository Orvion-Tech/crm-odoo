<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_crm_inquiry" model="ir.sequence">
            <field name="name">CRM Inquiry Sequence</field>
            <field name="code">crm.inquiry</field>
            <field name="prefix">INQ/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Make sure INR is active so all our Monetary fields can use it. -->
        <function model="res.currency" name="write">
            <value eval="[ref('base.INR')]"/>
            <value eval="{'active': True}"/>
        </function>
    </data>
</odoo>
