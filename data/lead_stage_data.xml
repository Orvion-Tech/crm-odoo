<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_crm_lead" model="ir.sequence">
            <field name="name">CRM Lead Sequence</field>
            <field name="code">crm.lead</field>
            <field name="prefix">LEAD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="lead_stage_new" model="crm.lead.stage">
            <field name="name">New</field>
            <field name="sequence">10</field>
        </record>

        <record id="lead_stage_qualified" model="crm.lead.stage">
            <field name="name">Qualified</field>
            <field name="sequence">20</field>
        </record>

        <record id="lead_stage_proposal" model="crm.lead.stage">
            <field name="name">Proposal</field>
            <field name="sequence">30</field>
        </record>

        <record id="lead_stage_negotiation" model="crm.lead.stage">
            <field name="name">Negotiation</field>
            <field name="sequence">40</field>
        </record>

        <record id="lead_stage_won" model="crm.lead.stage">
            <field name="name">Won</field>
            <field name="sequence">50</field>
            <field name="fold">True</field>
            <field name="is_won">True</field>
        </record>

        <record id="lead_stage_lost" model="crm.lead.stage">
            <field name="name">Lost</field>
            <field name="sequence">60</field>
            <field name="fold">True</field>
            <field name="is_lost">True</field>
        </record>

    </data>
</odoo>
