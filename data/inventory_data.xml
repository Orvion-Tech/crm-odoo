<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_crm_stock_move" model="ir.sequence">
            <field name="name">CRM Stock Move</field>
            <field name="code">crm.stock.move</field>
            <field name="prefix">SM/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Default warehouse so existing data and tests have something to work with. -->
        <record id="warehouse_main" model="crm.warehouse">
            <field name="code">WH-MAIN</field>
            <field name="name">Main Warehouse</field>
            <field name="is_default">True</field>
            <field name="sequence">1</field>
        </record>

    </data>
</odoo>
