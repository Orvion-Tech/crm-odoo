<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_crm_quotation" model="ir.sequence">
            <field name="name">CRM Quotation Sequence</field>
            <field name="code">crm.quotation</field>
            <field name="prefix">QTN/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="ir_cron_expire_quotations" model="ir.cron">
            <field name="name">CRM Custom: Expire Past-Validity Quotations</field>
            <field name="model_id" ref="model_crm_quotation"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_quotations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
