<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_dashboard_form" model="ir.ui.view">
        <field name="name">crm.dashboard.form</field>
        <field name="model">crm.dashboard</field>
        <field name="arch" type="xml">
            <form class="o_crm_custom_form o_crm_dashboard"
                  create="false" edit="false" delete="false">
                <sheet>
                    <field name="display_name" invisible="1"/>
                    <field name="currency_id" invisible="1"/>

                    <div class="o_crm_dashboard_header">
                        <div class="o_crm_dashboard_header_text">
                            <h2>CRM Dashboard</h2>
                            <p class="text-muted">Snapshot of your pipeline. Click any tile or row to drill in.</p>
                        </div>
                        <div class="o_crm_dashboard_header_actions">
                            <button name="action_refresh" type="object"
                                    class="btn btn-secondary"
                                    icon="fa-refresh">
                                Refresh
                            </button>
                        </div>
                    </div>

                    <!-- Section: Pipeline tiles -->
                    <div class="o_crm_dashboard_section_label">Pipeline</div>
                    <div class="o_crm_dashboard_grid">
                        <button name="action_open_inquiries" type="object"
                                class="o_crm_dashboard_tile">
                            <div class="tile-label">Open Inquiries</div>
                            <div class="tile-value"><field name="open_inquiries"/></div>
                            <div class="tile-sub">awaiting follow-up</div>
                        </button>

                        <button name="action_open_leads" type="object"
                                class="o_crm_dashboard_tile">
                            <div class="tile-label">Active Leads</div>
                            <div class="tile-value"><field name="active_leads"/></div>
                            <div class="tile-sub">in pipeline</div>
                        </button>

                        <button name="action_open_quotations_sent" type="object"
                                class="o_crm_dashboard_tile">
                            <div class="tile-label">Quotations Sent</div>
                            <div class="tile-value"><field name="quotations_sent"/></div>
                            <div class="tile-sub">awaiting response</div>
                        </button>

                        <button name="action_open_quotations_expiring" type="object"
                                class="o_crm_dashboard_tile tile-warning">
                            <div class="tile-label">Expiring ≤ 7 days</div>
                            <div class="tile-value"><field name="quotations_expiring"/></div>
                            <div class="tile-sub">follow up now</div>
                        </button>
                    </div>

                    <!-- Section: Orders & Cash tiles -->
                    <div class="o_crm_dashboard_section_label">Orders &amp; Cash</div>
                    <div class="o_crm_dashboard_grid">
                        <button name="action_open_orders" type="object"
                                class="o_crm_dashboard_tile">
                            <div class="tile-label">Open Orders</div>
                            <div class="tile-value"><field name="open_orders"/></div>
                            <div class="tile-sub">
                                <field name="open_orders_value" widget="monetary"/> in flight
                            </div>
                        </button>

                        <button name="action_open_unpaid_invoices" type="object"
                                class="o_crm_dashboard_tile">
                            <div class="tile-label">Unpaid Invoices</div>
                            <div class="tile-value"><field name="unpaid_invoices"/></div>
                            <div class="tile-sub">
                                <field name="unpaid_amount" widget="monetary"/> outstanding
                            </div>
                        </button>

                        <button name="action_open_overdue_invoices" type="object"
                                class="o_crm_dashboard_tile tile-danger">
                            <div class="tile-label">Overdue Invoices</div>
                            <div class="tile-value"><field name="overdue_invoices"/></div>
                            <div class="tile-sub">
                                <field name="overdue_amount" widget="monetary"/> past due
                            </div>
                        </button>

                        <button name="action_open_revenue_month" type="object"
                                class="o_crm_dashboard_tile tile-success">
                            <div class="tile-label">Revenue This Month</div>
                            <div class="tile-value">
                                <field name="revenue_month" widget="monetary"/>
                            </div>
                            <div class="tile-sub">
                                <field name="won_this_month"/> deals won
                            </div>
                        </button>
                    </div>

                    <!-- Section: Charts row -->
                    <div class="o_crm_dashboard_two_col">
                        <div class="o_crm_dashboard_panel">
                            <div class="o_crm_dashboard_panel_head">
                                <h3>Pipeline Funnel</h3>
                                <span class="o_crm_dashboard_panel_sub">Active leads by stage</span>
                            </div>
                            <field name="pipeline_funnel_html" widget="html" readonly="1"/>
                        </div>
                        <div class="o_crm_dashboard_panel">
                            <div class="o_crm_dashboard_panel_head">
                                <h3>Revenue — Last 6 Months</h3>
                                <span class="o_crm_dashboard_panel_sub">Paid invoices, monthly</span>
                            </div>
                            <field name="revenue_chart_html" widget="html" readonly="1"/>
                        </div>
                    </div>

                    <!-- Section: Activities + Top Products -->
                    <div class="o_crm_dashboard_two_col">
                        <div class="o_crm_dashboard_panel">
                            <div class="o_crm_dashboard_panel_head">
                                <h3>My Open Activities</h3>
                                <button name="action_open_my_activities" type="object"
                                        class="btn btn-link btn-sm">View all →</button>
                            </div>
                            <field name="my_activities_html" widget="html" readonly="1"/>
                        </div>
                        <div class="o_crm_dashboard_panel">
                            <div class="o_crm_dashboard_panel_head">
                                <h3>Top Products</h3>
                                <span class="o_crm_dashboard_panel_sub">By revenue (confirmed orders)</span>
                            </div>
                            <field name="top_products_html" widget="html" readonly="1"/>
                        </div>
                    </div>

                    <!-- Section: Recent Leads + Recent Quotations -->
                    <div class="o_crm_dashboard_two_col">
                        <div class="o_crm_dashboard_panel">
                            <div class="o_crm_dashboard_panel_head">
                                <h3>Recent Leads</h3>
                                <button name="action_open_leads" type="object"
                                        class="btn btn-link btn-sm">View all →</button>
                            </div>
                            <field name="recent_leads_html" widget="html" readonly="1"/>
                        </div>
                        <div class="o_crm_dashboard_panel">
                            <div class="o_crm_dashboard_panel_head">
                                <h3>Recent Quotations</h3>
                                <button name="action_open_quotations_sent" type="object"
                                        class="btn btn-link btn-sm">View all →</button>
                            </div>
                            <field name="recent_quotations_html" widget="html" readonly="1"/>
                        </div>
                    </div>

                    <!-- Section: Outstanding Invoices + Low Stock -->
                    <div class="o_crm_dashboard_two_col">
                        <div class="o_crm_dashboard_panel">
                            <div class="o_crm_dashboard_panel_head">
                                <h3>Outstanding Invoices</h3>
                                <button name="action_open_unpaid_invoices" type="object"
                                        class="btn btn-link btn-sm">View all →</button>
                            </div>
                            <field name="recent_invoices_html" widget="html" readonly="1"/>
                        </div>
                        <div class="o_crm_dashboard_panel">
                            <div class="o_crm_dashboard_panel_head">
                                <h3>Low Stock Alerts</h3>
                                <button name="action_open_low_stock" type="object"
                                        class="btn btn-link btn-sm">View all →</button>
                            </div>
                            <field name="low_stock_html" widget="html" readonly="1"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_dashboard" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="model_crm_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

    <menuitem id="menu_crm_dashboard"
              name="Dashboard"
              parent="menu_crm_root"
              action="action_crm_dashboard"
              sequence="1"/>

</odoo>
