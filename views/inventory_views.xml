<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============== Inventory (stock-on-hand) ============== -->

    <record id="view_crm_inventory_list" model="ir.ui.view">
        <field name="name">crm.inventory.list</field>
        <field name="model">crm.inventory</field>
        <field name="arch" type="xml">
            <list string="Stock On Hand" class="o_crm_custom_list"
                  decoration-danger="is_low_stock"
                  decoration-muted="quantity == 0">
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="quantity" sum="On Hand"/>
                <field name="reorder_min"/>
                <field name="is_low_stock" widget="boolean_toggle"/>
                <field name="move_count" string="Movements"/>
                <button name="action_adjust_stock" type="object"
                        string="Adjust" class="btn-link" icon="fa-pencil"/>
            </list>
        </field>
    </record>

    <record id="view_crm_inventory_form" model="ir.ui.view">
        <field name="name">crm.inventory.form</field>
        <field name="model">crm.inventory</field>
        <field name="arch" type="xml">
            <form string="Stock Line" class="o_crm_custom_form">
                <header>
                    <button name="action_adjust_stock" type="object"
                            string="Adjust Stock" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="move_count" widget="statinfo" string="Movements"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Low Stock" bg_color="text-bg-danger"
                            invisible="not is_low_stock"/>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Stock</span>
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="warehouse_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="quantity" readonly="1"/>
                            <field name="reorder_min"/>
                            <field name="is_low_stock" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recent Movements">
                            <field name="move_ids" readonly="1">
                                <list decoration-success="state == 'done'"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="date"/>
                                    <field name="reference"/>
                                    <field name="move_type"/>
                                    <field name="quantity"/>
                                    <field name="signed_quantity"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_inventory_search" model="ir.ui.view">
        <field name="name">crm.inventory.search</field>
        <field name="model">crm.inventory</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <filter string="Low Stock" name="filter_low"
                        domain="[('is_low_stock', '=', True)]"/>
                <filter string="In Stock" name="filter_in"
                        domain="[('quantity', '>', 0)]"/>
                <filter string="Out of Stock" name="filter_out"
                        domain="[('quantity', '&lt;=', 0)]"/>
                <separator/>
                <filter string="Warehouse" name="group_warehouse"
                        context="{'group_by': 'warehouse_id'}"/>
                <filter string="Product" name="group_product"
                        context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_crm_inventory" model="ir.actions.act_window">
        <field name="name">Stock On Hand</field>
        <field name="res_model">crm.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_inventory_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock yet</p>
            <p>Stock rows are created automatically when you record receipts (IN) or when an order ships from a warehouse.</p>
        </field>
    </record>

    <record id="action_crm_inventory_low" model="ir.actions.act_window">
        <field name="name">Low Stock</field>
        <field name="res_model">crm.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_low_stock', '=', True)]</field>
        <field name="search_view_id" ref="view_crm_inventory_search"/>
    </record>

    <!-- ============== Stock Moves ============== -->

    <record id="view_crm_stock_move_list" model="ir.ui.view">
        <field name="name">crm.stock.move.list</field>
        <field name="model">crm.stock.move</field>
        <field name="arch" type="xml">
            <list string="Stock Moves" class="o_crm_custom_list"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'draft'"
                  decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="reference"/>
                <field name="move_type"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="quantity"/>
                <field name="signed_quantity" string="Signed"/>
                <field name="sale_order_id" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_crm_stock_move_form" model="ir.ui.view">
        <field name="name">crm.stock.move.form</field>
        <field name="model">crm.stock.move</field>
        <field name="arch" type="xml">
            <form string="Stock Move" class="o_crm_custom_form">
                <header>
                    <button name="action_done" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Reference</span>
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="move_type" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="warehouse_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="quantity" readonly="state != 'draft'"/>
                            <field name="signed_quantity" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="user_id"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_crm_stock_move_search" model="ir.ui.view">
        <field name="name">crm.stock.move.search</field>
        <field name="model">crm.stock.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="sale_order_id"/>
                <filter string="Receipts (IN)" name="filter_in"
                        domain="[('move_type', '=', 'in')]"/>
                <filter string="Deliveries (OUT)" name="filter_out"
                        domain="[('move_type', '=', 'out')]"/>
                <filter string="Adjustments" name="filter_adjust"
                        domain="[('move_type', '=', 'adjust')]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Type" name="group_type" context="{'group_by': 'move_type'}"/>
                <filter string="Warehouse" name="group_wh" context="{'group_by': 'warehouse_id'}"/>
                <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_crm_stock_move" model="ir.actions.act_window">
        <field name="name">Stock Movements</field>
        <field name="res_model">crm.stock.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_stock_move_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock movements yet</p>
            <p>Use Receipts (IN) to add stock and adjustments to correct it. Deliveries (OUT) are recorded automatically when a Sales Order is marked delivered.</p>
        </field>
    </record>

    <!-- ============== Stock Adjust Wizard ============== -->

    <record id="view_crm_stock_adjust_wizard_form" model="ir.ui.view">
        <field name="name">crm.stock.adjust.wizard.form</field>
        <field name="model">crm.stock.adjust.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjust Stock">
                <group>
                    <field name="product_id" readonly="1"/>
                    <field name="warehouse_id" readonly="1"/>
                    <field name="current_qty" readonly="1"/>
                    <field name="target_qty"/>
                    <field name="reason" placeholder="e.g. cycle count, damage write-off"/>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============== Menus ============== -->

    <menuitem id="menu_inventory_main"
              name="Inventory"
              parent="menu_crm_root"
              sequence="30"/>

    <menuitem id="menu_inventory_stock"
              name="Stock On Hand"
              parent="menu_inventory_main"
              action="action_crm_inventory"
              sequence="10"/>

    <menuitem id="menu_inventory_low"
              name="Low Stock"
              parent="menu_inventory_main"
              action="action_crm_inventory_low"
              sequence="20"/>

    <menuitem id="menu_inventory_moves"
              name="Movements"
              parent="menu_inventory_main"
              action="action_crm_stock_move"
              sequence="30"/>

    <menuitem id="menu_inventory_warehouses"
              name="Warehouses"
              parent="menu_inventory_main"
              action="action_crm_warehouse"
              sequence="40"/>

</odoo>
