<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============== crm.product.category ============== -->
    <record id="view_product_category_list" model="ir.ui.view">
        <field name="name">crm.product.category.list</field>
        <field name="model">crm.product.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <record id="view_product_category_form" model="ir.ui.view">
        <field name="name">crm.product.category.form</field>
        <field name="model">crm.product.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Category Name"/></h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_category" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="res_model">crm.product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============== crm.product ============== -->
    <record id="view_product_list" model="ir.ui.view">
        <field name="name">crm.product.list</field>
        <field name="model">crm.product</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="reference"/>
                <field name="name"/>
                <field name="sku"/>
                <field name="category_id"/>
                <field name="list_price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_product_form" model="ir.ui.view">
        <field name="name">crm.product.form</field>
        <field name="model">crm.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="reference" class="oe_edit_only"/>
                        <h1><field name="reference" readonly="1"/></h1>
                        <label for="name" class="oe_edit_only"/>
                        <h2><field name="name" placeholder="Product Name"/></h2>
                    </div>
                    <group>
                        <group string="Catalog">
                            <field name="category_id"/>
                            <field name="sku"/>
                            <field name="active"/>
                        </group>
                        <group string="Pricing">
                            <field name="list_price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Product description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_kanban" model="ir.ui.view">
        <field name="name">crm.product.kanban</field>
        <field name="model">crm.product</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="currency_id"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <field name="image" widget="image" class="o_kanban_image"/>
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="category_id"/></div>
                                <div><field name="list_price" widget="monetary"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_product_search" model="ir.ui.view">
        <field name="name">crm.product.search</field>
        <field name="model">crm.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="name"/>
                <field name="sku"/>
                <field name="category_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">crm.product</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_product_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first smart lock product</p>
        </field>
    </record>

    <!-- ============== Menus ============== -->
    <menuitem id="menu_product_main"
              name="Products"
              parent="menu_crm_root"
              sequence="20"/>

    <menuitem id="menu_product"
              name="All Products"
              parent="menu_product_main"
              action="action_product"
              sequence="10"/>

    <menuitem id="menu_product_category"
              name="Categories"
              parent="menu_product_main"
              action="action_product_category"
              sequence="20"/>

</odoo>
